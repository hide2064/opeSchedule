{
  "version": "0.2.0",
  "configurations": [
    // ────────────────────────────────────────────────────────────────
    // [1] pytest: 全テスト実行
    //     tests/ ディレクトリ内の全テストをデバッガ下で実行する。
    // ────────────────────────────────────────────────────────────────
    {
      "name": "pytest: Run All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "--tb=short",
        "-s"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "APP_ENV": "development"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },

    // ────────────────────────────────────────────────────────────────
    // [2] pytest: 現在開いているテストファイルのみ実行
    // ────────────────────────────────────────────────────────────────
    {
      "name": "pytest: Current Test File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "--tb=long",
        "-s"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "APP_ENV": "development"
      },
      "justMyCode": false,
      "console": "integratedTerminal"
    },

    // ────────────────────────────────────────────────────────────────
    // [3] FastAPI: Docker デバッグアタッチ
    //     start_debug.ps1 で起動した Docker コンテナにアタッチする。
    //     事前に start_debug.ps1 を実行してコンテナを起動しておくこと。
    // ────────────────────────────────────────────────────────────────
    {
      "name": "FastAPI: Attach to Docker (port 5678)",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend",
          "remoteRoot": "/app/backend"
        }
      ],
      "justMyCode": false
    }
  ]
}
