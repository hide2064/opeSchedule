# opeSchedule 環境変数設定例
# このファイルを .env としてコピーして使用してください

# ── アプリケーション設定 ──────────────────────────────────────────────────
APP_ENV=development       # development | production
LOG_LEVEL=INFO
LOG_DIR=logs

# ── データベース ──────────────────────────────────────────────────────────
# SQLite（開発用）
DATABASE_URL=sqlite:///./opeschedule.db
# PostgreSQL（本番用）
# DATABASE_URL=postgresql://user:password@localhost:5432/opeschedule

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── メール通知 (D-1) ──────────────────────────────────────────────────────
# SMTP サーバー設定
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@opeschedule.local
SMTP_USE_TLS=true

# 通知の有効化・送信先・時刻は Config テーブル (管理画面) から設定できます
# ここで設定した SMTP 設定が送信に使用されます
